{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/sell-your-house", "destination": "/qld-suburbs", "permanent": true }
  ],
  "rewrites": [
    { "source": "/leads", "destination": "/leads.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/portal", "destination": "/portal.html" },
    { "source": "/sell", "destination": "/api/route-meta?view=sell" },
    { "source": "/buy", "destination": "/api/route-meta?view=buy" },
    { "source": "/fractional", "destination": "/api/route-meta?view=fractional" },
    { "source": "/my-listing", "destination": "/" },
    { "source": "/for-agents", "destination": "/api/route-meta?view=agents" },
    { "source": "/legal", "destination": "/" },
    { "source": "/qld-suburbs", "destination": "/api/suburb-page" },
    { "source": "/sell-your-house/:slug", "destination": "/api/suburb-page?slug=:slug" },
    { "source": "/offer/:path*", "destination": "/" },
    { "source": "/contract/:path*", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(admin|leads|portal)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ]
}
